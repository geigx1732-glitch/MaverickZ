local function stopFlying()
    isFlying = false
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
end

local function startFlying()
    isFlying = true
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        
        bv = Instance.new("BodyVelocity", hrp)
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bg = Instance.new("BodyGyro", hrp)
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)

        task.spawn(function()
            while isFlying do
                RunService.RenderStepped:Wait()
                if not char or not char:FindFirstChild("HumanoidRootPart") then break end
                
                local speed = flySpeedLevel * 30
                local hum = char:FindFirstChild("Humanoid")
                local moveDir = Vector3.zero
                
                if hum and hum.MoveDirection.Magnitude > 0 then
                    moveDir = hum.MoveDirection
                end
                
                local yDir = 0
                if upPressed then yDir = yDir + 1 end
                if downPressed then yDir = yDir - 1 end
                
                local targetVel = (moveDir * speed) + Vector3.new(0, yDir * speed, 0)
                if moveDir.Magnitude == 0 and yDir == 0 then
                    targetVel = Vector3.zero
                end
                
                bv.Velocity = targetVel
                bg.CFrame = Camera.CFrame
            end
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
        end)
    end
end

local function bindPress(btn, pressCB, releaseCB)
    btn.MouseButton1Down:Connect(pressCB)
    btn.MouseButton1Up:Connect(releaseCB)
    btn.MouseLeave:Connect(releaseCB)
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then pressCB() end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then releaseCB() end
    end)
end

