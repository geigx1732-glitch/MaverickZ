local function CreateTab(name, id)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, -10, 0, 32)
    tabBtn.BackgroundColor3 = Color3.fromRGB(28, 23, 40)
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(160, 150, 180)
    tabBtn.TextSize = 12
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.Parent = Sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = tabBtn

    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Name = id .. "Frame"
    scrollFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.ScrollBarThickness = 3
    scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(147, 51, 234)
    scrollFrame.Visible = false
    scrollFrame.Parent = ContentContainer

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 6)
    listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    listLayout.Parent = scrollFrame

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
    end)

    tabs[id] = scrollFrame
    tabButtons[id] = tabBtn

    tabBtn.MouseButton1Click:Connect(function()
        for tId, frame in pairs(tabs) do
            local isCurrent = (tId == id)
            frame.Visible = isCurrent
            tabButtons[tId].BackgroundColor3 = isCurrent and Color3.fromRGB(130, 45, 210) or Color3.fromRGB(28, 23, 40)
            tabButtons[tId].TextColor3 = isCurrent and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 150, 180)
        end
    end)

    return scrollFrame
end

